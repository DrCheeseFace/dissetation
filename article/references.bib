
@misc{alsufyani_visualization_2024,
	title = {Visualization of missing data: a state-of-the-art survey},
	shorttitle = {Visualization of missing data},
	url = {http://arxiv.org/abs/2410.03712},
	doi = {10.48550/arXiv.2410.03712},
	abstract = {Missing data, the data value that is not recorded for a variable, occurs in almost all statistical analyses and may be caused by many reasons, such as lack of collection or a lack of documentation. Researchers need to adequately deal with this issue to provide a valid analysis. The visualization of missing values plays an important role in supporting the investigation and understanding of the missing data patterns. While some techniques and tools for visualization of missing values are available, it is still a challenge to select the right visualization that will fulfil the user requirements for visualizing missing data. This paper provides an overview and state-of-the-art report (STAR) of research literature focusing on missing values visualization. To the best of our knowledge, this is the first survey paper with a focus on missing data visualization. The goal of this paper is to encourage visualization researchers to increase their involvement with Missing data visualization.},
	urldate = {2026-02-16},
	publisher = {arXiv},
	author = {Alsufyani, Sarah and Forshaw, Matthew and Fernstad, Sara Johansson},
	month = sep,
	year = {2024},
	note = {arXiv:2410.03712 [cs]},
	keywords = {Computer Science - Human-Computer Interaction},
	file = {Preprint PDF:/home/tharun/Zotero/storage/BWP6HNWK/Alsufyani et al. - 2024 - Visualization of missing data a state-of-the-art survey.pdf:application/pdf;Snapshot:/home/tharun/Zotero/storage/DIIUTK45/2410.html:text/html},
}

